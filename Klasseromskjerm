            document.getElementById(id)._cleanup = () => delete window[`state_dice_${id}`];
        }

        function initDrawingWidget(id, savedConfig) {
            const container = createWidgetFrame(id, 'Tegnebrett', 'fa-solid fa-pen-ruler', 'drawing', savedConfig);
            if (!savedConfig) {
                document.getElementById(id).style.width = '380px';
                document.getElementById(id).style.height = '340px';
            }
            container.innerHTML = `
                <div class="flex flex-col h-full gap-2">
                    <div class="flex gap-2 items-center justify-between bg-slate-100 p-2 rounded-xl">
                        <div class="flex gap-1">
                            <button onclick="setPenColor('${id}', '#000000')" class="w-6 h-6 rounded-full bg-black border border-slate-300"></button>
                            <button onclick="setPenColor('${id}', '#ef4444')" class="w-6 h-6 rounded-full bg-red-500 border border-slate-300"></button>
                            <button onclick="setPenColor('${id}', '#3b82f6')" class="w-6 h-6 rounded-full bg-blue-500 border border-slate-300"></button>
                            <button onclick="setPenColor('${id}', '#10b981')" class="w-6 h-6 rounded-full bg-emerald-500 border border-slate-300"></button>
                        </div>
                        <button onclick="clearCanvas('${id}')" class="text-xs text-red-600 font-bold hover:underline">Tøm brett</button>
                    </div>
                    <div class="flex-1 w-full h-full relative overflow-hidden rounded-xl border border-slate-200 bg-white">
                        <canvas id="${id}-canvas" class="w-full h-full cursor-crosshair block"></canvas>
                    </div>
                </div>
            `;
            setTimeout(() => {
                const canvas = document.getElementById(`${id}-canvas`);
                if (!canvas) return;
                function fitCanvasToParent() {
                    const rect = canvas.parentElement.getBoundingClientRect();
                    const tempCanvas = document.createElement('canvas');
                    tempCanvas.width = canvas.width; tempCanvas.height = canvas.height;
                    const tempCtx = tempCanvas.getContext('2d');
                    tempCtx.drawImage(canvas, 0, 0);
                    canvas.width = rect.width; canvas.height = rect.height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(tempCanvas, 0, 0);
                    ctx.lineWidth = 3; ctx.lineCap = 'round';
                }
                fitCanvasToParent();
                const resizeObs = new ResizeObserver(() => fitCanvasToParent());
                resizeObs.observe(canvas.parentElement);

                const ctx = canvas.getContext('2d');
                let isDrawing = false, currentColor = '#000000';
                ctx.lineWidth = 3; ctx.lineCap = 'round';

                window.setPenColor = (wId, color) => { currentColor = color; };
                window.clearCanvas = (wId) => {
                    const c = document.getElementById(`${wId}-canvas`);
                    if (c) c.getContext('2d').clearRect(0, 0, c.width, c.height);
                };
                function startDrawing(e) { isDrawing = true; draw(e); }
                function stopDrawing() { isDrawing = false; ctx.beginPath(); }
                function draw(e) {
                    if (!isDrawing) return;
                    const rect = canvas.getBoundingClientRect();
                    const x = (e.clientX || e.touches[0].clientX) - rect.left;
                    const y = (e.clientY || e.touches[0].clientY) - rect.top;
                    ctx.strokeStyle = currentColor;
                    ctx.lineTo(x, y); ctx.stroke();
                    ctx.beginPath(); ctx.moveTo(x, y);
                }
                canvas.addEventListener('mousedown', startDrawing);
                canvas.addEventListener('mouseup', stopDrawing);
                canvas.addEventListener('mousemove', draw);
                canvas.addEventListener('touchstart', startDrawing);
                canvas.addEventListener('touchend', stopDrawing);
                canvas.addEventListener('touchmove', draw);

                document.getElementById(id)._cleanup = () => resizeObs.disconnect();
            }, 100);
        }

        function initQRWidget(id, savedConfig) {
            const container = createWidgetFrame(id, 'QR-Kode Generator', 'fa-solid fa-qrcode', 'qr', savedConfig);
            container.innerHTML = `
                <div class="flex flex-col items-center gap-3 my-auto">
                    <div id="${id}-qrcode" class="p-2 bg-white rounded-xl shadow border border-slate-200 flex items-center justify-center min-h-[140px]"></div>
                    <input type="text" id="${id}-input" placeholder="Lim inn nettadresse her..." class="w-full text-xs p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <button onclick="generateQRCode('${id}')" class="w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow transition text-xs">Generer QR</button>
                </div>
            `;
            window.generateQRCode = (wId) => {
                const input = document.getElementById(`${wId}-input`);
                const qrContainer = document.getElementById(`${wId}-qrcode`);
                const url = input.value.trim();
                if (!url) return;
                qrContainer.innerHTML = '';
                new QRCode(qrContainer, { text: url, width: 128, height: 128 });
            };
            setTimeout(() => {
                const inp = document.getElementById(`${id}-input`);
                if (inp) {
                    inp.value = "https://www.utdanning.no";
                    window.generateQRCode(id);
                }
            }, 100);
        }

        // --- BAKGRUNNSBEHANDLING ---
        function toggleBackgroundModal() {
            document.getElementById('bg-modal').classList.toggle('hidden');
        }

        function setBackground(val) {
            applyBackground(val);
            try {
                localStorage.setItem('klasserom_bg', val);
            } catch (e) {}
            toggleBackgroundModal();
        }

        function applyBackground(val) {
            const body = document.getElementById('main-body');
            if (val.startsWith('color:')) {
                body.style.backgroundImage = 'none';
                body.style.backgroundColor = val.replace('color:', '');
            } else {
                body.style.backgroundImage = `url('${val}')`;
            }
        }

        function setCustomBackground() {
            const url = document.getElementById('bg-url-input').value.trim();
            if (url) setBackground(url);
        }

        // OPPSTART: Gjenopprett lagret tilstand ved innlasting
        window.addEventListener('DOMContentLoaded', () => {
            restoreLayoutState();
        });
    </script>
</body>
</html>
