        function initNoiseWidget(id, savedConfig) {
            const container = createWidgetFrame(id, 'Støymåler', 'fa-solid fa-microphone', 'noise', savedConfig);
            container.innerHTML = `
                <div class="flex flex-col items-center my-auto w-full">
                    <div class="w-full h-6 bg-slate-200 rounded-full overflow-hidden p-1 border border-slate-300 mb-3">
                        <div id="${id}-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-75 w-0"></div>
                    </div>
                    <div id="${id}-status" class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 text-center">Trykk på Start for å aktivere mikrofon</div>
                    <div id="${id}-error" class="hidden text-xs text-red-600 bg-red-50 border border-red-200 rounded-lg p-2.5 mb-3 text-center w-full font-medium leading-relaxed"></div>
                    <button id="${id}-btn" onclick="toggleMic('${id}')" class="px-4 py-2 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition">Start Måling</button>
                </div>
            `;
            let audioCtx, analyser, microphone, stream;
            window.toggleMic = async (wId) => {
                const btn = document.getElementById(`${wId}-btn`);
                const status = document.getElementById(`${wId}-status`);
                const bar = document.getElementById(`${wId}-bar`);
                const errorBox = document.getElementById(`${wId}-error`);

                if (errorBox) errorBox.classList.add('hidden');
                if (stream) {
                    stream.getTracks().forEach(track => track.stop());
                    if (audioCtx && audioCtx.state !== 'closed') audioCtx.close().catch(() => {});
                    stream = null; audioCtx = null;
                    btn.innerText = "Start Måling";
                    btn.className = "px-4 py-2 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition";
                    status.innerText = "Måling stoppet";
                    bar.style.width = "0%";
                    return;
                }
                const getMedia = (navigator.mediaDevices && navigator.mediaDevices.getUserMedia)
                    ? (c) => navigator.mediaDevices.getUserMedia(c)
                    : (c) => new Promise((res, rej) => {
                        const legacy = navigator.getUserMedia || navigator.webkitGetUserMedia || navigator.mozGetUserMedia;
                        if (!legacy) rej(new Error("NOT_SUPPORTED"));
                        else legacy.call(navigator, c, res, rej);
                    });

                try {
                    stream = await getMedia({ audio: true, video: false });
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    analyser = audioCtx.createAnalyser();
                    microphone = audioCtx.createMediaStreamSource(stream);
                    microphone.connect(analyser);
                    analyser.fftSize = 256;

                    btn.innerText = "Stopp Måling";
                    btn.className = "px-4 py-2 bg-red-600 text-white rounded-xl font-bold hover:bg-red-700 transition";
                    status.innerText = "Måler støynivå...";
                    status.className = "text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 text-center";
                    const dataArray = new Uint8Array(analyser.frequencyBinCount);

                    function checkVolume() {
                        if (!stream) return;
                        analyser.getByteFrequencyData(dataArray);
                        let sum = 0;
                        for (let i = 0; i < dataArray.length; i++) sum += dataArray[i];
                        let avg = sum / dataArray.length;
                        let vol = Math.min(100, Math.round((avg / 128) * 100));
                        bar.style.width = vol + "%";

                        if (vol > 70) {
                            bar.className = "h-full bg-red-500 rounded-full transition-all duration-75";
                            status.innerText = "For høyt støynivå!";
                            status.className = "text-xs font-bold text-red-600 uppercase tracking-wider mb-2 text-center animate-pulse";
                        } else if (vol > 40) {
                            bar.className = "h-full bg-amber-400 rounded-full transition-all duration-75";
                            status.innerText = "Moderat støynivå";
                            status.className = "text-xs font-bold text-amber-600 uppercase tracking-wider mb-2 text-center";
                        } else {
                            bar.className = "h-full bg-emerald-500 rounded-full transition-all duration-75";
                            status.innerText = "Fint støynivå";
                            status.className = "text-xs font-bold text-emerald-600 uppercase tracking-wider mb-2 text-center";
                        }
                        requestAnimationFrame(checkVolume);
                    }
                    checkVolume();
                } catch (err) {
                    let msg = "";
                    if (err.message === "NOT_SUPPORTED" || (typeof window.isSecureContext !== 'undefined' && !window.isSecureContext)) {
                        msg = "Mikrofontilgang krever HTTPS. Nettleseren sperrer mikrofonen over usikrede tilkoblinger.";
                    } else if (err.name === "NotAllowedError" || err.name === "PermissionDeniedError" || err.name === "SecurityError") {
                        msg = "Google Sites blokkerer mikrofonen i innbygde elementer. For å bruke støymåleren bør siden åpnes direkte som en HTML-fil.";
                    } else {
                        msg = "Kunne ikke starte støymåleren: " + (err.message || err.name || "Ukjent feil");
                    }
                    if (errorBox) {
                        errorBox.innerText = msg;
                        errorBox.classList.remove('hidden');
                    }
                    status.innerText = "Måling mislyktes";
                }
            };

            document.getElementById(id)._cleanup = () => {
                if (stream) stream.getTracks().forEach(t => t.stop());
                if (audioCtx && audioCtx.state !== 'closed') audioCtx.close().catch(() => {});
            };
        }

