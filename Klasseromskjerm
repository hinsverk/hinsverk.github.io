<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Klasseromskjerm</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        .widget {
            position: absolute;
            min-width: 220px;
            min-height: 180px;
            touch-action: none;
            user-select: none;
            transition: box-shadow 0.2s;
            resize: both;
            overflow: hidden;
        }
        .widget-header {
            cursor: move;
        }
        .widget::-webkit-resizer {
            background-color: rgba(99, 102, 241, 0.4);
            border-top-left-radius: 4px;
        }
        .bg-custom-cover {
            background-size: cover;
            background-position: center;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(107, 114, 128, 0.8);
        }
        .draggable-student {
            cursor: grab;
        }
        .draggable-student:active {
            cursor: grabbing;
        }
        .group-drop-zone.drag-over {
            border-color: #6366f1;
            background-color: #eef2ff;
        }
    </style>
</head>
<body id="main-body" class="h-screen w-screen overflow-hidden bg-slate-800 text-slate-800 relative bg-custom-cover" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1920&auto=format&fit=crop');">

    <div class="absolute inset-0 bg-black/10 pointer-events-none"></div>

    <div id="workspace" class="w-full h-full relative overflow-hidden">
        <div id="welcome-msg" class="absolute inset-0 flex flex-col items-center justify-center text-white text-center pointer-events-none p-4 drop-shadow-md transition-opacity duration-300">
            <i class="fa-solid font-bold text-6xl mb-4 fa-chalkboard-user"></i>
            <h1 class="text-4xl font-bold mb-2">Velkommen til Klasseromskjerm</h1>
            <p class="text-xl max-w-md">Velg verktøy fra menyen nederst for å komme i gang!</p>
        </div>
    </div>

    <div class="fixed bottom-4 left-1/2 -translate-x-1/2 bg-white/80 backdrop-blur-md border border-white/40 shadow-2xl rounded-2xl px-4 py-2 flex items-center gap-2 z-50 overflow-x-auto max-w-[95vw]">
        
        <button onclick="createWidget('clock')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Klokke og Dato">
            <i class="fa-regular fa-clock text-xl text-indigo-600 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Klokke</span>
        </button>

        <button onclick="createWidget('timer')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Nedtelling">
            <i class="fa-solid fa-hourglass-half text-xl text-amber-600 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Timer</span>
        </button>

        <button onclick="createWidget('traffic')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Trafikklys">
            <i class="fa-solid fa-traffic-light text-xl text-red-500 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Signal</span>
        </button>

        <button onclick="createWidget('work-symbols')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Arbeidssymboler">
            <i class="fa-solid fa-users text-xl text-blue-600 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Modus</span>
        </button>

        <button onclick="createWidget('noise')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Støymåler">
            <i class="fa-solid fa-microphone text-xl text-emerald-600 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Støy</span>
        </button>

        <button onclick="createWidget('randomizer')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Navnetrekker">
            <i class="fa-solid fa-shuffle text-xl text-purple-600 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Trekk</span>
        </button>

        <button onclick="createWidget('group-maker')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Gruppevelger">
            <i class="fa-solid fa-layer-group text-xl text-orange-500 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Grupper</span>
        </button>

        <button onclick="createWidget('dice')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Terning">
            <i class="fa-solid fa-dice-five text-xl text-rose-500 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Terning</span>
        </button>

        <button onclick="createWidget('drawing')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Tegnebrett">
            <i class="fa-solid fa-pen-ruler text-xl text-teal-600 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Tegn</span>
        </button>

        <button onclick="createWidget('qr')" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="QR-kode generator">
            <i class="fa-solid fa-qrcode text-xl text-cyan-600 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">QR</span>
        </button>

        <div class="h-8 w-[1px] bg-slate-300 mx-1"></div>

        <button onclick="toggleBackgroundModal()" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-white/60 active:scale-95 transition group" title="Endre bakgrunn">
            <i class="fa-solid fa-image text-xl text-slate-700 group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Bakgrunn</span>
        </button>
        
        <button onclick="clearAllWidgets()" class="flex flex-col items-center justify-center w-14 h-14 rounded-xl hover:bg-red-50 text-red-600 active:scale-95 transition group" title="Rydd skjermen">
            <i class="fa-regular fa-trash-can text-xl group-hover:scale-110 transition-transform"></i>
            <span class="text-[10px] font-medium mt-1">Rydd</span>
        </button>
    </div>

    <div id="bg-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl p-6 max-w-lg w-full shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold">Velg Bakgrunn</h2>
                <button onclick="toggleBackgroundModal()" class="text-slate-400 hover:text-slate-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-4">
                <button onclick="setBackground('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1920&auto=format&fit=crop')" class="h-20 rounded-lg overflow-hidden border-2 border-transparent hover:border-indigo-500 transition">
                    <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=300&auto=format&fit=crop" class="w-full h-full object-cover" alt="Strand">
                </button>
                <button onclick="setBackground('https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=80&w=1920&auto=format&fit=crop')" class="h-20 rounded-lg overflow-hidden border-2 border-transparent hover:border-indigo-500 transition">
                    <img src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=80&w=300&auto=format&fit=crop" class="w-full h-full object-cover" alt="Natur">
                </button>
                <button onclick="setBackground('https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=1920&auto=format&fit=crop')" class="h-20 rounded-lg overflow-hidden border-2 border-transparent hover:border-indigo-500 transition">
                    <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=300&auto=format&fit=crop" class="w-full h-full object-cover" alt="Fjell">
                </button>
                <button onclick="setBackground('https://images.unsplash.com/photo-1534447677768-be436bb09401?q=80&w=1920&auto=format&fit=crop')" class="h-20 rounded-lg overflow-hidden border-2 border-transparent hover:border-indigo-500 transition">
                    <img src="https://images.unsplash.com/photo-1534447677768-be436bb09401?q=80&w=300&auto=format&fit=crop" class="w-full h-full object-cover" alt="Rommet">
                </button>
                <button onclick="setBackground('color:#1e293b')" class="h-20 rounded-lg bg-slate-800 flex items-center justify-center text-white text-xs font-semibold hover:ring-2 hover:ring-indigo-500">Mørk Blå</button>
                <button onclick="setBackground('color:#0f172a')" class="h-20 rounded-lg bg-slate-900 flex items-center justify-center text-white text-xs font-semibold hover:ring-2 hover:ring-indigo-500">Mørk</button>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Egendefinert Bilde-URL</label>
                <div class="flex gap-2">
                    <input type="text" id="bg-url-input" placeholder="https://example.com/bilde.jpg" class="flex-1 px-3 py-2 border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <button onclick="setCustomBackground()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700">Bruk</button>
                </div>
            </div>
        </div>
    </div>

    <audio id="alarm-sound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

    <script>
        let highestZIndex = 100;
        const activeWidgets = new Map();

        // --- DEFAULTE LISTER SOM PERMANENT ER LAGRET I KODEN ---
        // Du kan redigere eller legge til nye lister direkte her i koden!
        let globalSavedLists = {
            "Eksempel 5A": "Kari, Ola, Per, Anne, Sofie, Lukas, Jonas, Nora, Henrik, Emil, Ida, Magnus"
        };

        function getSavedLists() {
            try {
                const local = JSON.parse(localStorage.getItem('klasserom_navnelister'));
                if (local && Object.keys(local).length > 0) {
                    return { ...globalSavedLists, ...local };
                }
            } catch (e) {}
            return globalSavedLists;
        }

        function saveNamedList(name, content) {
            if (!name) return;
            globalSavedLists[name] = content;
            try {
                localStorage.setItem('klasserom_navnelister', JSON.stringify(globalSavedLists));
            } catch (e) {}
            updateAllListDropdowns();
        }

        function deleteNamedList(name) {
            if (!name) return;
            delete globalSavedLists[name];
            try {
                localStorage.setItem('klasserom_navnelister', JSON.stringify(globalSavedLists));
            } catch (e) {}
            updateAllListDropdowns();
        }

        function updateAllListDropdowns() {
            const lists = getSavedLists();
            const selects = document.querySelectorAll('.class-list-select');
            selects.forEach(select => {
                const currentVal = select.value;
                select.innerHTML = '<option value="">-- Velg lagret liste --</option>';
                Object.keys(lists).forEach(listName => {
                    const opt = document.createElement('option');
                    opt.value = listName;
                    opt.innerText = listName;
                    select.appendChild(opt);
                });
                select.value = currentVal;
            });
        }

        function saveLayoutState() {
            const layout = [];
            activeWidgets.forEach((widget, id) => {
                layout.push({
                    id: id,
                    type: widget.dataset.type,
                    top: widget.style.top,
                    left: widget.style.left,
                    width: widget.style.width,
                    height: widget.style.height,
                    zIndex: widget.style.zIndex
                });
            });
            try {
                localStorage.setItem('klasserom_layout', JSON.stringify(layout));
            } catch (e) {}
        }

        function restoreLayoutState() {
            try {
                const saved = localStorage.getItem('klasserom_layout');
                if (saved) {
                    const layout = JSON.parse(saved);
                    layout.forEach(item => {
                        createWidget(item.type, item);
                    });
                }
                const savedBg = localStorage.getItem('klasserom_bg');
                if (savedBg) {
                    applyBackground(savedBg);
                }
            } catch (e) {}
        }

        function updateWelcomeMsg() {
            const welcome = document.getElementById('welcome-msg');
            if (activeWidgets.size > 0) {
                welcome.classList.add('opacity-0');
            } else {
                welcome.classList.remove('opacity-0');
            }
        }

        function createWidgetFrame(id, title, iconClass, type, savedConfig = null) {
            const workspace = document.getElementById('workspace');
            const widget = document.createElement('div');
            widget.id = id;
            widget.dataset.type = type;
            widget.className = 'widget bg-white/90 backdrop-blur-md rounded-2xl shadow-xl border border-white/60 flex flex-col overflow-hidden';
            
            if (savedConfig) {
                widget.style.left = savedConfig.left;
                widget.style.top = savedConfig.top;
                widget.style.width = savedConfig.width;
                widget.style.height = savedConfig.height;
                widget.style.zIndex = savedConfig.zIndex || ++highestZIndex;
                if (savedConfig.zIndex > highestZIndex) highestZIndex = parseInt(savedConfig.zIndex);
            } else {
                const randomX = Math.max(20, Math.floor(Math.random() * (window.innerWidth - 420)));
                const randomY = Math.max(20, Math.floor(Math.random() * (window.innerHeight - 420)));
                widget.style.left = `${randomX}px`;
                widget.style.top = `${randomY}px`;
                widget.style.width = '320px';
                widget.style.height = 'auto';
                widget.style.zIndex = ++highestZIndex;
            }

            const header = document.createElement('div');
            header.className = 'widget-header px-4 py-3 bg-slate-100/80 border-b border-slate-200/60 flex items-center justify-between cursor-move select-none';
            header.innerHTML = `
                <div class="flex items-center gap-2 font-semibold text-slate-700 text-sm">
                    <i class="${iconClass}"></i>
                    <span>${title}</span>
                </div>
                <div class="flex items-center gap-1">
                    <button onclick="closeWidget('${id}')" class="w-6 h-6 rounded-full hover:bg-red-100 text-slate-400 hover:text-red-600 flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark text-xs"></i>
                    </button>
                </div>
            `;

            const body = document.createElement('div');
            body.className = 'widget-body p-4 flex-1 flex flex-col overflow-auto';

            widget.appendChild(header);
            widget.appendChild(body);
            workspace.appendChild(widget);

            makeDraggable(widget, header);

            widget.addEventListener('mousedown', () => {
                widget.style.zIndex = ++highestZIndex;
                saveLayoutState();
            });

            const resizeObserver = new ResizeObserver(() => {
                saveLayoutState();
            });
            resizeObserver.observe(widget);
            widget._resizeObserver = resizeObserver;

            activeWidgets.set(id, widget);
            updateWelcomeMsg();
            saveLayoutState();

            return body;
        }

        function closeWidget(id) {
            const widget = document.getElementById(id);
            if (widget) {
                if (widget._resizeObserver) widget._resizeObserver.disconnect();
                if (typeof widget._cleanup === 'function') {
                    try { widget._cleanup(); } catch (e) {}
                }
                widget.remove();
                activeWidgets.delete(id);
                updateWelcomeMsg();
                saveLayoutState();
            }
        }

        function clearAllWidgets() {
            activeWidgets.forEach((_, id) => closeWidget(id));
            localStorage.removeItem('klasserom_layout');
        }

        function makeDraggable(element, handle) {
            let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
            handle.onmousedown = dragMouseDown;

            function dragMouseDown(e) {
                if (e.target.closest('.draggable-student') || e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT' || e.target.tagName === 'BUTTON') return;

                e = e || window.event;
                e.preventDefault();
                pos3 = e.clientX;
                pos4 = e.clientY;
                document.onmouseup = closeDragElement;
                document.onmousemove = elementDrag;
                element.style.zIndex = ++highestZIndex;
            }

            function elementDrag(e) {
                e = e || window.event;
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;
                element.style.top = (element.offsetTop - pos2) + "px";
                element.style.left = (element.offsetLeft - pos1) + "px";
            }

            function closeDragElement() {
                document.onmouseup = null;
                document.onmousemove = null;
                saveLayoutState();
            }
        }

        function createWidget(type, savedConfig = null) {
            const id = savedConfig ? savedConfig.id : 'widget-' + Date.now();
            if (activeWidgets.has(id)) return;

            switch (type) {
                case 'clock': initClockWidget(id, savedConfig); break;
                case 'timer': initTimerWidget(id, savedConfig); break;
                case 'traffic': initTrafficWidget(id, savedConfig); break;
                case 'work-symbols': initWorkSymbolsWidget(id, savedConfig); break;
                case 'noise': initNoiseWidget(id, savedConfig); break;
                case 'randomizer': initRandomizerWidget(id, savedConfig); break;
                case 'group-maker': initGroupMakerWidget(id, savedConfig); break;
                case 'dice': initDiceWidget(id, savedConfig); break;
                case 'drawing': initDrawingWidget(id, savedConfig); break;
                case 'qr': initQRWidget(id, savedConfig); break;
            }
        }

        // --- WIDGET IMPLEMENTASJONER ---

        function initClockWidget(id, savedConfig) {
            const container = createWidgetFrame(id, 'Klokke og Dato', 'fa-regular fa-clock', 'clock', savedConfig);
            container.innerHTML = `
                <div class="text-center py-2 my-auto">
                    <div id="${id}-time" class="text-5xl font-extrabold text-slate-800 tracking-tight font-mono">00:00:00</div>
                    <div id="${id}-date" class="text-sm font-semibold text-indigo-600 mt-2 uppercase tracking-wide">Laster...</div>
                </div>
            `;
            function updateTime() {
                const now = new Date();
                const timeEl = document.getElementById(`${id}-time`);
                const dateEl = document.getElementById(`${id}-date`);
                if (!timeEl) return;
                timeEl.innerText = now.toLocaleTimeString('no-NO');
                dateEl.innerText = now.toLocaleDateString('no-NO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            }
            updateTime();
            const interval = setInterval(updateTime, 1000);
            document.getElementById(id)._cleanup = () => clearInterval(interval);
        }

        function initTimerWidget(id, savedConfig) {
            const container = createWidgetFrame(id, 'Timer', 'fa-solid fa-hourglass-half', 'timer', savedConfig);
            container.innerHTML = `
                <div class="flex flex-col items-center my-auto">
                    <div id="${id}-display" class="text-5xl font-extrabold text-slate-800 my-2 font-mono">05:00</div>
                    <div class="flex gap-2 my-2">
                        <button onclick="addTimerSeconds('${id}', 60)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-xs font-semibold rounded">+1 min</button>
                        <button onclick="addTimerSeconds('${id}', 300)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-xs font-semibold rounded">+5 min</button>
                        <button onclick="addTimerSeconds('${id}', 600)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-xs font-semibold rounded">+10 min</button>
                    </div>
                    <div class="flex gap-3 mt-3 w-full">
                        <button id="${id}-start" onclick="toggleTimer('${id}')" class="flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow transition">Start</button>
                        <button onclick="resetTimer('${id}')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-xl transition">Nullstill</button>
                    </div>
                </div>
            `;
            const state = { timeLeft: 300, isRunning: false, interval: null };
            window[`state_${id}`] = state;

            window.updateTimerDisplay = (wId) => {
                const s = window[`state_${wId}`];
                if (!s) return;
                const mins = Math.floor(s.timeLeft / 60).toString().padStart(2, '0');
                const secs = (s.timeLeft % 60).toString().padStart(2, '0');
                const display = document.getElementById(`${wId}-display`);
                if (display) display.innerText = `${mins}:${secs}`;
            };

            window.toggleTimer = (wId) => {
                const s = window[`state_${wId}`];
                if (!s) return;
                const btn = document.getElementById(`${wId}-start`);
                if (s.isRunning) {
                    clearInterval(s.interval);
                    s.isRunning = false;
                    if (btn) {
                        btn.innerText = 'Start';
                        btn.className = 'flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow transition';
                    }
                } else {
                    if (s.timeLeft <= 0) return;
                    s.isRunning = true;
                    if (btn) {
                        btn.innerText = 'Pause';
                        btn.className = 'flex-1 py-2 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow transition';
                    }
                    s.interval = setInterval(() => {
                        if (s.timeLeft > 0) {
                            s.timeLeft--;
                            window.updateTimerDisplay(wId);
                        } else {
                            clearInterval(s.interval);
                            s.isRunning = false;
                            if (btn) {
                                btn.innerText = 'Start';
                                btn.className = 'flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow transition';
                            }
                            document.getElementById('alarm-sound').play().catch(() => {});
                            confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
                        }
                    }, 1000);
                }
            };

            window.addTimerSeconds = (wId, secs) => {
                const s = window[`state_${wId}`];
                if (!s) return;
                s.timeLeft += secs;
                window.updateTimerDisplay(wId);
            };

            window.resetTimer = (wId) => {
                const s = window[`state_${wId}`];
                if (!s) return;
                clearInterval(s.interval);
                s.isRunning = false;
                s.timeLeft = 300;
                const btn = document.getElementById(`${wId}-start`);
                if (btn) {
                    btn.innerText = 'Start';
                    btn.className = 'flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow transition';
                }
                window.updateTimerDisplay(wId);
            };

            document.getElementById(id)._cleanup = () => {
                if (state.interval) clearInterval(state.interval);
                delete window[`state_${id}`];
            };
        }

        function initTrafficWidget(id, savedConfig) {
            const container = createWidgetFrame(id, 'Trafikklys', 'fa-solid fa-traffic-light', 'traffic', savedConfig);
            container.innerHTML = `
                <div class="flex flex-col items-center gap-3 py-2 bg-slate-900 rounded-xl p-3 shadow-inner my-auto">
                    <button onclick="setLight('${id}', 'red')" id="${id}-red" class="w-16 h-16 rounded-full bg-red-950 border-2 border-red-500/30 transition-all duration-300"></button>
